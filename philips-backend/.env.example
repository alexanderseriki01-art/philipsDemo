# Phillips Consulting TMS — temporary demo API

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos

# Leave EMPTY for the standard setup. The host nginx proxies /tms/ with a
# trailing-slash proxy_pass, which already strips the prefix before the request
# reaches this app. Only set this if you switch to a proxy that forwards the
# sub-path intact — setting it alongside a stripping proxy 404s every route.
APP_PATH_PREFIX=

# Comma-separated origins allowed to call the API. Use * to allow any.
# Bearer tokens are used (no cookies), so * carries no CSRF risk here.
CORS_ALLOWED_ORIGINS=*

# Session token lifetime, in seconds. Default 8 hours.
AUTH_TOKEN_TTL=28800

# Failed sign-in attempts allowed per email+IP inside the decay window.
AUTH_MAX_ATTEMPTS=10
AUTH_THROTTLE_DECAY=900

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Invitations are sent through Resend. The API key must belong to an account
# where the MAIL_FROM domain is VERIFIED, or Resend answers 403 and nothing is
# delivered. phillipsconsulting.net is not verified on the available accounts,
# so the default sends from a verified domain and shows Phillips Consulting as
# the sender name, with replies routed to Phillips.
#
# Once phillipsconsulting.net is verified in the same Resend account, the only
# change needed is MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=training@colat.ng
MAIL_FROM_NAME=Phillips Consulting
MAIL_REPLY_TO=training@phillipsconsulting.net

# Base URL of the participant-facing site, used for the activation link.
PORTAL_URL=https://philips-demo.vercel.app

# Fill thresholds for derived programme status, as a fraction of seats taken.
# At or above NEARLY_FULL is "nearly-full"; below UNDER_TARGET is "under-target".
FILL_NEARLY_FULL=0.85
FILL_UNDER_TARGET=0.60
